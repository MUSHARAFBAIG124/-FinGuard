FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

COPY services/ai/requirements.txt /app/services/ai/requirements.txt
RUN python -m pip install --no-cache-dir -r /app/services/ai/requirements.txt

RUN useradd --create-home --uid 10001 appuser
COPY --chown=appuser:appuser services/ai/app /app/services/ai/app
COPY --chown=appuser:appuser services/ai/models /app/services/ai/models

WORKDIR /app/services/ai
USER appuser
EXPOSE 8000

CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
