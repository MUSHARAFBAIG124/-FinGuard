# FinGuard AI local development environment. These values are development-only.
# Configure production values in Railway or Render Variables; never commit .env.

NODE_ENV=development
APP_NAME=FinGuard AI
API_HOST=127.0.0.1
API_PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/finguard_ai
JWT_ACCESS_SECRET=local-access-secret-for-development-only
JWT_REFRESH_SECRET=local-refresh-secret-for-development-only
AI_SERVICE_URL=http://localhost:8000/api/v1
AI_SERVICE_BASE_URL=http://localhost:8000
AI_HEALTH_TIMEOUT_MS=1500
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_DEMO_MODE_ENABLED=false
