# Shared
NODE_ENV=development
APP_NAME=FinGuard AI

# API
API_PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/finguard_ai
JWT_ACCESS_SECRET=replace-with-strong-access-token-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-token-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
REFRESH_TOKEN_COOKIE_NAME=finguard_refresh_token
BCRYPT_SALT_ROUNDS=12
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=15
EMAIL_VERIFICATION_TTL_HOURS=24
CSRF_COOKIE_NAME=finguard_csrf
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# AI service
AI_SERVICE_PORT=8000
AI_SERVICE_BASE_URL=http://localhost:8000
AI_HEALTH_TIMEOUT_MS=1500
MODEL_ARTIFACT_DIR=./models/artifacts

# Frontend
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_APP_NAME=FinGuard AI
