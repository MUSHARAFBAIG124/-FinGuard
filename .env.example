# ─────────────────────────────────────────────────────────────────────────────
# FinGuard AI – Environment Variables Template
#
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Shared ──────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME=FinGuard AI

# ─── Backend API (apps/api) ──────────────────────────────────────────────────

# Server
PORT=4000
API_PORT=4000
API_BASE_URL=http://localhost:4000

# Frontend origin (CORS)
FRONTEND_URL=http://localhost:5173
WEB_BASE_URL=http://localhost:5173

# MongoDB – use a local URI for development or Atlas for production
# Format: mongodb://user:password@host:port/database
#         mongodb+srv://user:password@cluster.mongodb.net/database
MONGODB_URI=mongodb://localhost:27017/finguard_ai

# JWT Secrets – generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-strong-access-token-secret
JWT_ACCESS_SECRET=replace-with-strong-access-token-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-token-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Auth settings
REFRESH_TOKEN_COOKIE_NAME=finguard_refresh_token
BCRYPT_SALT_ROUNDS=12
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=15
EMAIL_VERIFICATION_TTL_HOURS=24

# CSRF & Rate Limiting
CSRF_COOKIE_NAME=finguard_csrf
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── AI Service (services/ai) ─────────────────────────────────────────────────

# AI service connection
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_PORT=8000
AI_HEALTH_TIMEOUT_MS=1500

# Model artifacts directory (relative to services/ai)
MODEL_DIR=./models
MODEL_ARTIFACT_DIR=./models/artifacts

# Port for uvicorn (AI service)
PORT=8000

# ─── Frontend (apps/web) ──────────────────────────────────────────────────────

VITE_API_URL=http://localhost:4000/api/v1
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_APP_NAME=FinGuard AI
VITE_DEMO_MODE_ENABLED=false
